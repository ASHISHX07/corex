<Project Sdk="Microsoft.NET.Sdk">

  <Target Name="ValidateRequiredFiles" BeforeTargets="Build">
	  <ItemGroup>
	    <!-- <RequiredFiles Include="" /> -->
	  </ItemGroup> 
  </Target>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    
    <Configuration>Debug</Configuration>
    <CoreXEnvironment Condition="'$(Configuration)' == 'Debug'">Development</CoreXEnvironment>
    <CoreXEnvironment Condition="'$(Configuration)' == 'Release'">Production</CoreXEnvironment>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);PERF_PROFILE</DefineConstants>
	  <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	  <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata
      Include="CoreXEnvironment"
      Value="$(CoreXEnvironment)"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="fyers-api-v3" Version="1.5.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="upstox-dotnet-sdk" Version="2.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Content
      Include="..\..\..\config\appsettings.json"
      Link="config\%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublicDirectory="PreserveNewest"
    />

    <Content
      Include="..\..\..\config\broker.config.json"
      Link="config\%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublicDirectory="PreserveNewest"
    />

    <Compile Include="..\..\..\shared\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
