{
	"Diagnostics": {
		"logging": true,
		"profiling": true
	},

	"CoreXAuthServer": {
		"BaseUri": "https://corex-server.corex-services.workers.dev",
		"AuthEndpoint": "/api/v1/auth/sessions",
		"GetAuthCodeEndpoint": "/api/v1/auth/sessions/:sessionId/result",
		"PollIntervalMs": 1000,
		"TimeoutSeconds": 120
	},

	"ActiveBroker": "Upstox",

	"Brokers": {
		"Upstox": {
			"BaseUri": "https://api.upstox.com",
			"TokenExchangeEndpoint": "/v3/login/authorization/token"
		},

		"Fyers": {
			"BaseUri": "https://api-t1.fyers.in",
			"TokenExchangeEndpoint": "/api/v3/validate-authcode"
		}
	}
}