{
	"Diagnostics": {
		"logging": true,
		"profiling": true
	},

	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft": "Warning",
			"System.Net.Http.HttpClient": "Warning"
		}
	},

	"CoreXServer": {
		"BaseUri": "https://corex-server-v3.corex-services.workers.dev/",
		"Endpoints": {
			"CreateAuthSession": "api/v3/auth/sessions",
			"GetAuthSessionResult": "api/v3/auth/sessions/<sessionId>/result"
		},
		"PollIntervalMs": 3000,
		"TimeoutSeconds": 120
	},

	"ActiveBroker": "Upstox",

	"Brokers": {
		"Upstox": {
			"BaseUri": "https://api.upstox.com/",
			"Endpoints": {
				"UserProfile": "v2/user/profile",
				"OptionContracts": "v2/option/contract",
				"GetQuotes": "v3/market-quote/quotes"
			},
			"IndexInstrumentKeys": [
				"NSE_INDEX|Nifty 50",
				"NSE_INDEX|Nifty Bank"
			],
			"ApiPollIntervalMs": 500
		},

		"Fyers": {
			"BaseUri": "https://api-t1.fyers.in/",
			"Endpoints": {
				"TokenExchangeEndpoint": ""
			}
		}
	}
}