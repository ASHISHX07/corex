{
	"Diagnostics": {
		"logging": true,
		"profiling": true
	},

	"CoreXServer": {
		"BaseUri": "https://corex-server-v3.corex-services.workers.dev/",
		"Endpoints": {
			"CreateAuthSession": "api/v3/auth/sessions",
			"GetAuthSessionResult": "api/v3/auth/sessions/<sessionId>/result"
		},
		"PollIntervalMs": 3000,
		"TimeoutSeconds": 120
	},

	"ActiveBroker": "Upstox",

	"Brokers": {
		"Upstox": {
			"BaseUri": "https://api.upstox.com/",
			"Endpoints": {
				"UserProfile": "v2/user/profile"
			}
		},

		"Fyers": {
			"BaseUri": "https://api-t1.fyers.in/",
			"Endpoints": {
				"TokenExchangeEndpoint": ""
			}
		}
	}
}