{
	"Diagnostics": {
		"logging": true,
		"profiling": true
	},

	"CoreXServer": {
		"BaseUri": "https://corex-server.corex-services.workers.dev/",
		"Endpoints": {
			"CreateSession": "api/v2/auth/sessions",
			"GetSessionResult": "api/v2/auth/sessions/{sessionId}/result"
		},
		"PollIntervalMs": 1000,
		"TimeoutSeconds": 20
	},

	"ActiveBroker": "Upstox",

	"Brokers": {
		"Upstox": {
			"BaseUri": "https://api.upstox.com",
			"Endpoints": {
				"TokenExchangeEndpoint": ""
			}
		},

		"Fyers": {
			"BaseUri": "https://api-t1.fyers.in",
			"Endpoints": {
				"TokenExchangeEndpoint": ""
			}
		}
	}
}